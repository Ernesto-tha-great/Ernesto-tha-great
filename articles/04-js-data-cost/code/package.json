{
  "name": "js-data-cost",
  "version": "0.1.0",
  "private": true,
  "description": "What it costs real people to load popular websites, priced in mobile data across 50 countries.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:prices": "tsx scripts/fetch-prices.ts",
    "fetch:income": "tsx scripts/fetch-income.ts",
    "measure": "tsx scripts/measure.ts",
    "report": "tsx scripts/report.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "budget": "tsx scripts/budget.ts"
  },
  "dependencies": {
    "playwright": "1.56"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
